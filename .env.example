# ===== 模型配置 =====
# 对话模型提供方：ollama（本地免费，默认推荐）或 deepseek（云端，需要 API Key）
MODEL_PROVIDER=ollama
# DeepSeek（备选；仅当 MODEL_PROVIDER=deepseek 且填写 KEY 时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 本地 Ollama（对话主模型默认走这里；嵌入固定使用本地）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90
# SQLite
AGENT_DB_PATH=

# ===== MCP 天气服务（stdio，不占端口）=====
# weather-mcp-server 脚本绝对路径（缺省回退到《Agent搭建说明书》仓库下的 examples/mcp-server/server.py）
WEATHER_MCP_SERVER=
# 上游天气凭据（缺省则 server 返回受控错误 MISSING_TOKEN，不崩）
WEATHER_API_TOKEN=
WEATHER_TIMEOUT_SEC=8
